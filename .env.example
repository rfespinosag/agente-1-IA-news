NOTION_MCP_TOKEN=
NOTION_ALLOWED_TOOLS=

# MCP de Gmail (Composio u otro proveedor compatible).
GMAIL_MCP_URL=
GMAIL_MCP_TOKEN=
GMAIL_ALLOWED_TOOLS=
COMPOSIO_MCP_URL=
COMPOSIO_MCP_API_KEY=
